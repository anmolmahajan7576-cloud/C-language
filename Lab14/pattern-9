#include <stdio.h>
int main()
{
   for(int i=1;i<=5;i++){
       for(int j=5;j>=i;j--){
           printf(" ");
       }
       for(int k=1;k<=(i*2)-1;k++){
           printf("*");
       }
       printf("\n");
   }
   for(int t=5-1;t>=1;t--){
     for(int y=5;y>=t;y--){
         printf(" ");
     }
     for(int r=1;r<=(t*2)-1;r++){
         printf("*");
     }
     printf("\n");
 }
 return 0;
}

