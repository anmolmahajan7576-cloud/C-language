#include <stdio.h>
int main() 
{
    int arr[5]={4,5,8,9,1};
    
    for(int i=0;i< 5;i++){
        for(int j=1;j<5;j++){
            if(arr[j]<arr[j-1]){
                int c=arr[j];
                arr[j]=arr[j-1];
                arr[j-1]=c;
            }
        }
    }
    for(int i = 0 ;i<5 ;i++)
    printf("%d\n",arr[i]);

    
    return 0;
}
